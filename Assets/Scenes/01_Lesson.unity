  m_Script: {fileID: 11500000, guid: 8b75c7b2e4198b74cb8b16f71dfa0f28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EscapeFire.Runtime::EscapeFire.Lesson.LessonStation
  title: "1. Tam gi\xE1c ch\xE1y"
  explanation: "\u0110\xE1m ch\xE1y c\u1EA7n \u0111\u1EE7 ba y\u1EBFu t\u1ED1: CH\u1EA4T
    CH\xC1Y, NHI\u1EC6T v\xE0 OXY. Lo\u1EA1i b\u1ECF m\u1ED9t y\u1EBFu t\u1ED1 l\xE0
    l\u1EEDa t\u1EAFt. B\xECnh CO2 l\xE0m l\u1EEDa t\u1EAFt v\xEC \u0111\u1EA9y oxy
    ra v\xE0 l\xE0m l\u1EA1nh."
  ruleId: R12_FIRE_TRIANGLE
  question: "\u0110\u1EADy n\u1EAFp l\xE0m l\u1EEDa t\u1EAFt v\xEC \u0111\xE3 lo\u1EA1i
    b\u1ECF y\u1EBFu t\u1ED1 n\xE0o?"
  options:
  - "Nhi\u1EC7t"
  - Oxy
  - "Ch\u1EA5t ch\xE1y"
  correctOption: 1
  whyCorrect: "N\u1EAFp k\xEDn ng\u0103n kh\xF4ng kh\xED, l\u1EEDa thi\u1EBFu oxy
    n\xEAn t\u1EAFt."
  practice: {fileID: 910025261}
  board: {fileID: 1294422280}
  feedback: {fileID: 1421531030}
  lamp: {fileID: 2048506570}
