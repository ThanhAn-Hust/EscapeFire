  m_Name: 
  m_EditorClassIdentifier: EscapeFire.Runtime::EscapeFire.Lesson.LessonStation
  title: "3. K\u1EF9 thu\u1EADt PASS"
  explanation: "P \u2013 R\xFAt ch\u1ED1t (tay kia gi\u1EEF b\xECnh). A \u2013 Ch\u0129a
    loa v\xE0o G\u1ED0C l\u1EEDa. S \u2013 B\xF3p c\xF2. S \u2013 Qu\xE9t qua l\u1EA1i.
    \u0110\u1EE9ng c\xE1ch kho\u1EA3ng 1,8\u20132,4 m. B\xECnh CO2 5 kg ch\u1EC9
    phun \u0111\u01B0\u1EE3c ~10\u201312 gi\xE2y."
  ruleId: R04_PASS
  question: "Khi d\u1EADp l\u1EEDa ph\u1EA3i ch\u0129a loa phun v\xE0o \u0111\xE2u?"
  options:
  - "Ng\u1ECDn l\u1EEDa tr\xEAn cao"
  - "G\u1ED1c l\u1EEDa"
  - "Kh\xF3i ph\xEDa tr\xEAn"
  correctOption: 1
  whyCorrect: "Ch\u1EA5t ch\u1EEFa ch\xE1y ph\u1EA3i ph\u1EE7 v\xE0o g\u1ED1c, n\u01A1i
    ch\u1EA5t ch\xE1y \u0111ang ch\xE1y."
  practice: {fileID: 1570878887}
  board: {fileID: 1443994848}
  feedback: {fileID: 290025895}
  lamp: {fileID: 1783785841}
