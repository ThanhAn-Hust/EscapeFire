  m_Name: 
  m_EditorClassIdentifier: EscapeFire.Runtime::EscapeFire.Lesson.LessonStation
  title: "2. Ch\u1ECDn \u0111\xFAng b\xECnh"
  explanation: "Ch\xE1y thi\u1EBFt b\u1ECB \u0111i\u1EC7n: KH\xD4NG d\xF9ng n\u01B0\u1EDBc
