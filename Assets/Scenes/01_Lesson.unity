  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8b75c7b2e4198b74cb8b16f71dfa0f28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EscapeFire.Runtime::EscapeFire.Lesson.LessonStation
  title: "5. Tho\xE1t n\u1EA1n trong kh\xF3i"
  explanation: "Kh\xF3i v\xE0 kh\xED n\xF3ng b\u1ED1c l\xEAn cao, kh\xF4ng kh\xED
    s\u1EA1ch \u1EDF s\xE1t s\xE0n. C\xFAi th\u1EA5p ho\u1EB7c b\xF2, che m\u0169i
    mi\u1EC7ng b\u1EB1ng kh\u0103n \u01B0\u1EDBt. KH\xD4NG d\xF9ng thang m\xE1y;
    \u0111i c\u1EA7u thang b\u1ED9 theo bi\u1EC3n EXIT. S\u1EDD c\u1EEDa b\u1EB1ng
    mu b\xE0n tay tr\u01B0\u1EDBc khi m\u1EDF."
  ruleId: R07_STAY_LOW
  question: "H\xE0nh lang c\xF3 kh\xF3i, t\u1EA7ng c\u1EE7a b\u1EA1n c\xF3 thang
    m\xE1y v\xE0 c\u1EA7u thang b\u1ED9. B\u1EA1n \u0111i l\u1ED1i n\xE0o?"
  options:
  - "Thang m\xE1y cho nhanh"
  - "C\u1EA7u thang b\u1ED9, c\xFAi th\u1EA5p"
  - "Ch\u1EA1y th\u1EB3ng ng\u01B0\u1EDDi qua kh\xF3i"
  correctOption: 1
  whyCorrect: "Thang m\xE1y c\xF3 th\u1EC3 m\u1EA5t \u0111i\u1EC7n v\xE0 k\u1EB9t;
    kh\xF3i \u1EDF tr\xEAn cao n\xEAn ph\u1EA3i c\xFAi th\u1EA5p."
  practice: {fileID: 1810563026}
  board: {fileID: 1845902206}
  feedback: {fileID: 644848530}
  lamp: {fileID: 59351701}
